{
  "roles": [
    {
      "id": "swiftwind",
      "name": "疾風",
      "params": {
        "hp": 20,
        "atk": 5,
        "def": 2,
        "spe": 13,
        "bra": 1
      },
      "abilities": [
        {
          "id": "swiftwind_gain_spe_on_attack",
          "trigger": "afterRoleAttack",
          "actions": [
            {
              "addStatToken": {
                "stat": "spe",
                "value": 1
              }
            }
          ],
          "text": "攻撃後 Speトークン+1"
        },
        {
          "id": "swiftwind_gain_bra_on_spe_threshold",
          "trigger": "onStatTotalChanged",
          "condition": {
            "stat": "spe",
            "threshold": {
              "from": 15,
              "step": 5
            },
            "direction": "up"
          },
          "actions": [
            {
              "addStatToken": {
                "stat": "bra",
                "value": 1
              }
            }
          ],
          "text": "Spe合計が15以上で5刻みを跨ぐたびBraトークン+1"
        },
        {
          "id": "swiftwind_spend_spe_reduce_damage",
          "trigger": "beforeDamageTaken",
          "playerChoice": {
            "spendStatToken": {
              "stat": "spe",
              "min": 0,
              "max": "any"
            }
          },
          "actions": [
            {
              "reduceIncomingDamageBy": "spent"
            }
          ],
          "text": "被ダメージ時、追加Speトークンを自動で消費して同量だけ被ダメ軽減"
        }
      ],
      "tags": [
        "basic"
      ]
    },
    {
      "id": "anger",
      "name": "憤怒",
      "params": {
        "hp": 20,
        "atk": 11,
        "def": 0,
        "spe": 5,
        "bra": 1
      },
      "abilities": [
        {
          "id": "anger_gain_atk_on_damage",
          "trigger": "afterDamageTaken",
          "actions": [
            {
              "addStatToken": {
                "stat": "atk",
                "value": {
                  "ratioOf": "damageTaken",
                  "ratio": 0.5,
                  "round": "floor"
                }
              }
            }
          ],
          "text": "HPが2減るごとにAtkトークン+1（受けたダメージ/2を切り捨て）"
        }
      ],
      "tags": [
        "basic"
      ]
    },
