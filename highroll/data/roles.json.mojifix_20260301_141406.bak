{
  "roles": [
    {
      "id": "swiftwind",
      "name": "疾風",
      "params": {
        "hp": 30,
        "atk": 5,
        "def": 2,
        "spe": 13,
        "bra": 1
      },
      "text": "Spe特化。攻撃でSpe+、Spe到達でBra+、被ダメ時にSpeで軽減（自動）。",
      "detailText": "パッシブ1：攻撃を行うたびに追加Speを獲得する。\nパッシブ2：追加Speが15以上の倍数になるたびにBraが増える（例: 15, 20, 25...）。\nパッシブ3：ダメージを受けるとき、追加Speを自動で消費して軽減する（ロール/カードダメージのみ。炎上などの特殊ダメージは軽減不可）。",
      "tags": [
        "basic"
      ]
    },
    {
      "id": "anger",
      "name": "憤怒",
      "params": {
        "hp": 30,
        "atk": 11,
        "def": 0,
        "spe": 5,
        "bra": 1
      },
      "text": "被ダメでAtkが伸びる高火力ロール（Def低）。",
      "detailText": "基礎Atkが高い。その代わりDefが低い。\nパッシブ1：HPが2減るごとに追加Atkを獲得する。",
      "tags": [
        "basic"
      ]
    },
    {
      "id": "monster",
      "name": "怪物",
      "params": {
        "hp": 10,
        "atk": 10,
        "def": 20,
        "spe": 10,
        "bra": 1
      },
      "text": "高ステータス。ただし終盤に最大HP=1。",
      "detailText": "全ステータスが高い。\nパッシブ1：残りプレイヤーが2人になったとき、最大HPが1になる。",
      "tags": [
        "basic"
      ]
    },
    {
      "id": "bomb",
      "name": "爆弾",
      "params": {
        "hp": 30,
        "atk": 8,
        "def": 3,
        "spe": 8,
        "bra": 1
      },
      "text": "攻撃で自傷、被ダメで反射。時限爆弾を設置できる。",
      "detailText": "パッシブ1：攻撃するとき、与えたダメージの1/4を自分も受ける。\nパッシブ2：攻撃を受けるとき、攻撃者にも受けたダメージの1/2を与える。\nアビリティ1：Braを1消費して、誰か1人に「時限爆弾」を設置する（カウント3→そのプレイヤーのターン終了ごとに-1、0で固定10ダメージ）。",
      "tags": [
        "basic"
      ]
    },
    {
      "id": "murderer",
      "name": "殺人",
      "params": {
        "hp": 30,
        "atk": 6,
        "def": 2,
        "spe": 8,
        "bra": 2
      },
      "text": "キルで成長（血塗れの剣と相性）。",
      "detailText": "パッシブ1：誰かを殺害するたびにステータスが上がる。\nパッシブ2：『血塗れの剣』を装備するとさらにステータスが上がる（カード効果に従う）。",
      "tags": [
        "basic",
        "synergy:bloodied_sword"
      ]
    },
    {
      "id": "discharge",
      "name": "放電",
      "params": {
        "hp": 30,
        "atk": 5,
        "def": 4,
        "spe": 5,
        "bra": 2
      },
      "text": "蓄電→放電で全体に感電をばらまく。",
      "detailText": "パッシブ1：ターン終了時、余ったBraを蓄電トークンとして蓄積する。\nアビリティ：自分のターン中に放電すると、(蓄電トークン^2)の感電トークンを自分以外の全員に付与する。\nパッシブ2：感電トークン5つにつき、そのプレイヤーはそのターンBraを1使えない。使えなかったBra1につき感電トークンを5消費する。\nパッシブ3：自分は感電トークンによるBra減衰が起こらない。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "doctor",
      "name": "医師",
      "params": {
        "hp": 30,
        "atk": 4,
        "def": 3,
        "spe": 5,
        "bra": 2
      },
      "text": "支援ロール（治療/麻酔/手術/整形）。",
      "detailText": "アビリティ1：治療（対象のHPを3回復する）。\nアビリティ2：麻酔（対象は次のターンBra-1）。\nアビリティ3：手術（対象の次ターンを休ませ、その次のターン開始時にHP+15）。\nアビリティ4：整形（対象のステータスを1減らし、別のステータスを1増やす）。",
      "tags": [
        "advanced",
        "support"
      ]
    },
    {
      "id": "flame",
      "name": "火炎",
      "params": {
        "hp": 30,
        "atk": 3,
        "def": 5,
        "spe": 7,
        "bra": 2
      },
      "text": "炎上付与。自分は炎上で回復。",
      "detailText": "アビリティ：Braを消費して炎上を付与する。\nパッシブ1：炎上はターン終了時に炎上値だけダメージを与え、炎上-1。\nパッシブ2：火炎は炎上ダメージの代わりに回復する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "resonate",
      "name": "反響",
      "params": {
        "hp": 30,
        "atk": 6,
        "def": 3,
        "spe": 6,
        "bra": 1
      },
      "text": "連続攻撃（2/3減衰）。ヒットごとに自傷1。",
      "detailText": "パッシブ1：すべての攻撃が連続攻撃になる。\nパッシブ2：最初のダメージは通常のロール攻撃（Atk-Def、最小1）。以降は与えるダメージが1未満になるまで、与えるダメージを2/3にして繰り返す（切り捨て）。\nパッシブ3：誰かにダメージを与えるたび、自分は固定1ダメージを受ける。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "efficiency",
      "name": "効率",
      "params": {
        "hp": 15,
        "atk": 2,
        "def": 1,
        "spe": 3,
        "bra": 2
      },
      "text": "アイテム効果が2倍。",
      "detailText": "パッシブ1：全てのアイテム効果が2倍になる。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "greed",
      "name": "貪欲",
      "params": {
        "hp": 30,
        "atk": 5,
        "def": 5,
        "spe": 5,
        "bra": 2
      },
      "text": "追加トークン獲得→同量HP回復に置換。",
      "detailText": "パッシブ1：追加トークンを獲得したとき、代わりに獲得するはずだったトークン数だけHPを回復する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "postpone",
      "name": "延期",
      "params": {
        "hp": 30,
        "atk": 4,
        "def": 3,
        "spe": 10,
        "bra": 2
      },
      "text": "行動後に“延期”して追加行動できる。",
      "detailText": "アビリティ：最初の行動後、「延期」して残りのBraで全員の行動後に追加行動できる。\nパッシブ1：ラウンド中に受けたダメージは即時反映されず、追加ターン開始時にまとめて受ける。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "jester",
      "name": "道化",
      "params": {
        "hp": 15,
        "atk": 2,
        "def": 2,
        "spe": 2,
        "bra": 3
      },
      "text": "Bra1でランダム効果。",
      "detailText": "アビリティ：Braを1消費してランダムな効果を得る。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "suppress",
      "name": "抑制",
      "params": {
        "hp": 30,
        "atk": 3,
        "def": 3,
        "spe": 3,
        "bra": 2
      },
      "text": "対象の固有能力を抑制（次ラウンド終了まで）。",
      "detailText": "アビリティ：Braを1消費して対象を選ぶ。対象は次のラウンド終了まで固有能力（パッシブ）を失う。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "barrage",
      "name": "連撃",
      "params": {
        "hp": 30,
        "atk": 3,
        "def": 3,
        "spe": 8,
        "bra": 2
      },
      "text": "追加攻撃可能。攻撃でAtk(そのターン)+1。",
      "detailText": "アビリティ：1回目のロール攻撃後、Braを1消費して追加攻撃できる。\nパッシブ1：ターン中にその相手へ初めて攻撃した場合、Braを1獲得する。\nパッシブ2：攻撃する度、このターンのAtkが+1される。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "strong_greed",
      "name": "強欲",
      "params": {
        "hp": 30,
        "atk": 5,
        "def": 2,
        "spe": 6,
        "bra": 1
      },
      "text": "「次のうちどれか選ぶ」を全発動できる。",
      "detailText": "パッシブ1：「次のうちどれか選ぶ」を持つカードは、全ての効果を発動する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "shed",
      "name": "脱皮",
      "params": {
        "hp": 30,
        "atk": 1,
        "def": 9,
        "spe": 1,
        "bra": 1
      },
      "text": "Bra1でDefを捨て、Atk/Speへ変換する。",
      "detailText": "アビリティ1：Braを1消費して「脱皮」できる。\nアビリティ2：脱皮するとDefを0にし、失ったDefの半分（切り捨て）をAtkとSpeそれぞれ追加トークンとして得る。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "seal",
      "name": "封印",
      "params": {
        "hp": 30,
        "atk": 0,
        "def": 0,
        "spe": 0,
        "bra": 2
      },
      "text": "鎖で基礎ステータスを強化し、相手の手札を封印する。",
      "detailText": "アビリティ：Braを1消費して、次のうちどれかを選ぶ。\n\nアビリティ1：攻鎖（基礎Atkを2獲得する）。\nアビリティ2：防鎖（基礎Defを1獲得する）。\nアビリティ3：速鎖（基礎Speを3獲得する）。\nアビリティ4：封鎖（誰か1人を選ぶ。そのプレイヤーのランダムな手札1枚を「封印」する。封印された手札は使用できない）。\nパッシブ1：自分の手札が封印されるたび、封印された枚数ぶん山札から引く。\nパッシブ2：ロール攻撃時、自分の封印されている手札の枚数×2だけAtkを加算して計算する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "giant",
      "name": "巨人",
      "params": {
        "hp": 100,
        "atk": 7,
        "def": 0,
        "spe": 0,
        "bra": 1
      },
      "text": "超高HP・高火力。ただし装備/防御不可＆反動あり。",
      "detailText": "基礎HPが非常に高い。\n装備を付けることができない。\n防御カードを使うことができない。\nDefとSpeは1以上にならない。\nパッシブ1：ロールで攻撃時、与えたダメージの1/2（切り捨て）を自分も受ける。\nパッシブ2：ロールで攻撃時、攻撃したプレイヤーにめまい1を付与する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "witch",
      "name": "魔女",
      "params": {
        "hp": 15,
        "atk": 4,
        "def": 2,
        "spe": 7,
        "bra": 2
      },
      "text": "呪いで手札に干渉し、呪文使用で成長。",
      "detailText": "パッシブ1：呪文カードを使うたび、最大HP+1し、HP+1回復する。\nアビリティ1：Braを1消費して誰か1人を選ぶ。そのプレイヤーの手札ランダム1枚に呪いを付与する。\n呪いはカードに追加効果をもたらす。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "vampire",
      "name": "吸血",
      "params": {
        "hp": 30,
        "atk": 6,
        "def": 1,
        "spe": 7,
        "bra": 1
      },
      "text": "出血付与と回復で粘るロール。",
      "detailText": "パッシブ1：ロールで攻撃時、攻撃したプレイヤーに出血1を付与し、与えたダメージの1/2（切り捨て）を回復する。\nパッシブ2：出血が付与されているプレイヤーに攻撃するときは、代わりに与えたダメージの3/4（切り捨て）を回復する。\nアビリティ1：自分のHPを2消費して、自身の手札1枚に「血の紋様」を付与する。\nパッシブ3：手札にある「血の紋様」が付与されたカード1枚につき、追加Atk+1を獲得する。",
      "tags": [
        "advanced"
      ]
    },
    {
      "id": "duplicate",
      "name": "複製",
      "params": {
        "hp": 30,
        "atk": 3,
        "def": 2,
        "spe": 7,
        "bra": 2
      },
      "text": "固有能力を複製して使うロール（最大3つまで保存）。",
      "detailText": "アビリティ1：誰か1人を選ぶ。Braを1消費して、そのプレイヤーの［固有能力］を「複製」する。\nパッシブ1：複製した能力のパッシブは自動で発動する。\nパッシブ2：複製した能力のアビリティも本物と同様に使用できる。\n補足：複製は3つまで保存でき、4つ目以降を複製する場合は最初に複製したものから消える。\n補足：同じプレイヤーから2回目の複製はできない。\n補足：装備による追加能力は複製できない。",
      "tags": [
        "advanced"
      ]
    },
